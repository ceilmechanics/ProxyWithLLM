</math></span><img src="https://wikimedia.org/api/rest_v1/media/math/render/svg/02ab04d70b9c35dd550d538c609bb66d97c91fae" class="mwe-math-fallback-image-inline mw-invert skin-invert" aria-hidden="true" style="vertical-align: -0.671ex; width:2.387ex; height:2.009ex;" alt="{\displaystyle v_{\text{L}}}"></span> and <span class="mwe-math-element"><span class="mwe-math-mathml-inline mwe-math-mathml-a11y" style="display: none;"><math xmlns="http://www.w3.org/1998/Math/MathML"  alttext="{\displaystyle v_{\text{S}}}">
  <semantics>
