  }

  .fc-send-button:hover {
    background: #4338ca !important;
  }

  /* Add this to your existing CSS */
  .fc-loading-spinner {
    display: flex;
    justify-content: center;
    padding: 20px;
  }

  .fc-loading-spinner::after {
    content: "";
    width: 30px;
    height: 30px;
    border: 3px solid #e5e7eb;
    border-top: 3px solid #4f46e5;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Add this to hide/show the sections */
  .fc-suggested-questions.loading {
    display: none;
  }

  .fc-loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    background: white; /* Ensure visible background */
  }

  .fc-spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #f3f3f3; /* Light grey */
    border-top: 4px solid #4f46e5; /* Blue */
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Hide spinner by default */
  .fc-loading-container {
    display: none;
  }

  /* Show spinner when loading */
  .fc-loading-container.show {
    display: flex;
  }

  .fc-typing-indicator {
    color: #666;
  }

  .fc-typing-indicator span {
    animation: typing 1.4s infinite;
  }

  .fc-typing-indicator span:nth-child(2) {
    animation-delay: 0.2s;
  }

  .fc-typing-indicator span:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes typing {
    0%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  .fc-formatted-response {
    padding: 10px !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
    font-family: system-ui, -apple-system, sans-serif !important;
  }

  .fc-formatted-section {
    margin-bottom: 15px !important;
  }

  .fc-formatted-title {
    color: #4f46e5 !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    margin: 0 0 8px 0 !important;
    padding: 0 !important;
  }

  .fc-formatted-list {
    margin: 0 !important;
    padding-left: 20px !important;
    list-style-type: disc !important;
  }

  .fc-formatted-item {
    margin-bottom: 5px !important;
    padding: 0 !important;
    color: #1f2937 !important;
    line-height: 1.4 !important;
  }
</style></head>
